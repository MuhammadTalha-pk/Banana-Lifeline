APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=*

# Friend AI package / model
BANANA_AI_ROOT=D:/Hackathon/Banana-Lifeline/ai
BANANA_MODEL_CHECKPOINT=D:/Hackathon/Banana-Lifeline/ai/runs/<run>/best.pt
VISION_MIN_CONFIDENCE=0.75

# Firebase Admin. Download a service-account JSON from:
# Firebase Console > Project settings > Service accounts.
GOOGLE_APPLICATION_CREDENTIALS=D:/secure/banana-lifeline-service-account.json
FIREBASE_PROJECT_ID=banana-lifeline

# Zero-billing local media storage
MEDIA_DIR=./uploads

# RAG
KNOWLEDGE_DIR=./knowledge
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=./.qdrant
QDRANT_COLLECTION=banana_lifeline_knowledge
EMBEDDING_MODEL=BAAI/bge-m3
RAG_TOP_K=5

# LLM generation
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Google Cloud Speech-to-Text uses GOOGLE_APPLICATION_CREDENTIALS.
SPEECH_ENABLED=true
